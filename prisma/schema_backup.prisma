generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nombre     String
  contrasena String
  creadoEn   DateTime @default(now())
  rolId      Int
  rol        Rol      @relation(fields: [rolId], references: [id])
}

model Carrera {
  id        Int       @id @default(autoincrement())
  nombre    String
  codigo    String    @unique
  estado    Boolean   @default(true)
  createdAt DateTime  @default(now())
  Horario   Horario[]
  niveles   Nivel[]
}

model Nivel {
  id          Int          @id @default(autoincrement())
  nombre      String
  semestre    Int
  carreraId   Int
  asignaturas Asignatura[]
  Horario     Horario[]
  carrera     Carrera      @relation(fields: [carreraId], references: [id])
}

model Docente {
  id                Int                 @id @default(autoincrement())
  nombres           String
  apellidos         String
  cedula            String              @unique
  correo            String              @unique
  telefono          String?
  createdAt         DateTime            @default(now())
  estado            Boolean             @default(true)
  titulo            String?
  AsignaturaDocente AsignaturaDocente[]
  Horario           Horario[]
}

model Asignatura {
  id                Int                 @id @default(autoincrement())
  codigo            String              @unique
  nombre            String
  creditos          Int
  horasSemana       Int
  nivelId           Int
  nivel             Nivel               @relation(fields: [nivelId], references: [id])
  AsignaturaDocente AsignaturaDocente[]
  Horario           Horario[]
}

model Aula {
  id        Int       @id @default(autoincrement())
  codigo    String    @unique
  capacidad Int?
  tipo      String?
  estado    Boolean   @default(true)
  createdAt DateTime  @default(now())
  horarios  Horario[]
}

model PeriodoAcademico {
  id          Int       @id @default(autoincrement())
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  Horario     Horario[]
}

model Seccion {
  id        Int       @id @default(autoincrement())
  nombre    String
  createdAt DateTime  @default(now())
  Horario   Horario[]
}

model Horario {
  id               Int              @id @default(autoincrement())
  diaSemana        String
  horaInicio       String
  horaFin          String
  docenteId        Int
  asignaturaId     Int
  aulaId           Int
  periodoId        Int
  seccionId        Int
  createdAt        DateTime         @default(now())
  carreraId        Int
  nivelId          Int
  Asignatura       Asignatura       @relation(fields: [asignaturaId], references: [id])
  aula             Aula             @relation(fields: [aulaId], references: [id])
  Carrera          Carrera          @relation(fields: [carreraId], references: [id])
  Docente          Docente          @relation(fields: [docenteId], references: [id])
  Nivel            Nivel            @relation(fields: [nivelId], references: [id])
  PeriodoAcademico PeriodoAcademico @relation(fields: [periodoId], references: [id])
  Seccion          Seccion          @relation(fields: [seccionId], references: [id])

  @@unique([diaSemana, horaInicio, horaFin, aulaId])
  @@unique([diaSemana, horaInicio, horaFin, docenteId])
  @@unique([diaSemana, horaInicio, horaFin, seccionId])
}

model AsignaturaDocente {
  id           Int        @id @default(autoincrement())
  docenteId    Int
  asignaturaId Int
  Asignatura   Asignatura @relation(fields: [asignaturaId], references: [id])
  Docente      Docente    @relation(fields: [docenteId], references: [id])

  @@unique([docenteId, asignaturaId])
}
